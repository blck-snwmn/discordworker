{
	"name": "discordworker",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@12.9.1",
	"scripts": {
		"deploy": "cf deploy --mode production",
		"start": "cf dev",
		"cf-typegen": "cf workers types",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/ test/",
		"fmt:check": "oxfmt --check src/ test/"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.3.6",
		"@types/node": "26.6.4",
		"cf": "1.0.0-beta.12",
		"oxfmt": "0.71.0",
		"oxlint": "1.87.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "7.0.2",
		"vitest": "4.1.11",
		"wrangler": "4.147.0"
	},
	"type": "module"
}
