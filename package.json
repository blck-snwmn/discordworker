{
	"name": "discordworker",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"deploy": "cf deploy --mode production",
		"start": "cf dev",
		"cf-typegen": "cf workers types",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/ test/",
		"fmt:check": "oxfmt --check src/ test/"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.5",
		"@types/node": "26.6.5",
		"cf": "1.0.0-beta.18",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.151.2"
	},
	"type": "module"
}
