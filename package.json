{
	"name": "discordworker",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@12.22.0",
	"scripts": {
		"deploy": "cf deploy --mode production",
		"start": "cf dev",
		"cf-typegen": "cf workers types",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/ test/",
		"fmt:check": "oxfmt --check src/ test/"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.4.12",
		"@types/node": "26.6.6",
		"cf": "1.0.0-rc.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.166.0"
	},
	"type": "module"
}
